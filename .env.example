# ─────────────────────────────────────────────────────────────────────────────
# Modello di configurazione dello spike del ponte — Spesuccia
#
# COPIA questo file in `bridge/.env` e riempilo. `bridge/.env` è escluso dal
# .gitignore dal primo commit e NON deve mai essere committato, incollato in
# chat, allegato a un messaggio o copiato in un servizio di appunti condiviso.
#
#     cp .env.example .env          (macOS/Linux)
#     copy .env.example .env        (Windows)
#
# Alternativa migliore su una macchina condivisa: non creare il file e passare
# gli stessi nomi come variabili d'ambiente. Lo spike guarda prima l'ambiente.
#
# Procedura completa per ottenere questi valori: `SETUP_KEEP.md` nella radice.
# ─────────────────────────────────────────────────────────────────────────────

# Indirizzo dell'ACCOUNT GOOGLE DEDICATO — mai quello di una persona vera.
# È l'account creato apposta e aggiunto come collaboratore alla nota: la
# superficie di rischio del master token è quel solo account (brief Sez. 2.1).
#
# ⚠️ Si lascia VUOTO in questo file, e non per pigrizia: ADR-0012 §3 porta il
# ponte in un repository pubblico, e questo è l'indirizzo dell'account che
# custodisce il master token. Pubblicarlo non svela un segreto — ma dice a
# chiunque passi *quale* casella provare a forzare, e il master token vale
# quanto la password.
SPESUCCIA_KEEP_EMAIL=

# ⚠️ MASTER TOKEN dell'account dedicato. Comincia per `aas_et/`.
# Dà accesso COMPLETO a quell'account: vale quanto la password, e non scade
# quando chiudi il browser. Si revoca cambiando la password dell'account
# (SETUP_KEEP.md, passo 6).
# Lo spike non lo stampa mai, nemmeno troncato, nemmeno negli errori.
SPESUCCIA_KEEP_MASTER_TOKEN=

# ID della NOTA DI PROVA. Si legge dall'URL di keep.google.com quando la nota
# è aperta: .../u/0/#LIST/<QUESTO>
# ⚠️ NON l'ID della nota reale della spesa. Lo stesso valore va ripetuto a mano
# sulla riga di comando con --conferma-nota: è la conferma esplicita che
# chiedono il brief Sez. 5.1 e Sez. 13.
SPESUCCIA_KEEP_NOTE_ID=

# Identificativo di dispositivo (l'`androidId` che gpsoauth si aspetta):
# 16 cifre esadecimali minuscole. Generane UNO SOLO, la prima volta, con:
#     python -c "import secrets; print(secrets.token_hex(8))"
# e poi non cambiarlo più: è legato al token e va conservato accanto ad esso.
# Se lo lasci vuoto lo spike si rifiuta di partire — di proposito: gkeepapi
# altrimenti userebbe il MAC address della macchina, che cambia se il ponte
# un giorno gira altrove.
SPESUCCIA_KEEP_DEVICE_ID=

# ── Guardie di sicurezza (valori predefiniti sensati: cambiali solo se sai perché)

# Titolo della nota REALE. Lo spike si rifiuta di toccare una nota che si
# chiami così, qualunque ID gli venga passato.
SPESUCCIA_KEEP_TITOLO_REALE=Spesuccia

# Marcatore che il titolo della nota di prova DEVE contenere,
# per esempio «Spesuccia PROVA».
SPESUCCIA_KEEP_MARCATORE_PROVA=PROVA

# Numero massimo di righe che una nota di prova può avere. Oltre questa soglia
# lo spike si ferma: una nota con settanta righe è una lista della spesa vera.
SPESUCCIA_KEEP_MAX_RIGHE=40

# ── Il ciclo di M3 (ADR-0012) ────────────────────────────────────────────────
#
# ⚠️ Queste due NON vivono in questo file quando il ponte gira davvero: stanno
# nei Secrets di GitHub, cifrati e invisibili anche su un repository pubblico.
# Qui servono solo a chi lancia `python avvia.py` dal proprio computer per
# provare un ciclo a mano.

# Indirizzo delle due Edge Function. Deve essere https: su http il token del
# ponte viaggerebbe in chiaro, e il ciclo si rifiuta di partire.
SPESUCCIA_URL_FUNZIONI=

# Il segreto condiviso con keep-pull e keep-ack (ADR-0012 §4). Lo stesso valore
# va nei secrets del progetto Supabase come SPESUCCIA_TOKEN_PONTE.
# Generane uno con:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
SPESUCCIA_TOKEN_PONTE=
